<% I18n.with_locale(interface_locale) do %>
<!--Descriptive page name, messages and instructions-->
<h2 class="heading"><%= t(".page_heading") %></h2>

<%= error_messages_for @work %>
<!--/descriptions-->

<!--subnav-->
<ul class="navigation actions">
  <% if @unposted %>
    <li>
      <%= link_to t(".restore_draft"), url_for(action: :new, load_unposted: true) %>
    </li>
  <% end %>
  <li>
    <%= link_to( t(".import"),
      {:url => {:controller => :works, :action => :new, :import => true}},
      :href => url_for(:controller => :works, :action => :new, :import => true)) %>
  </li>
</ul>
<!--/subnav-->

<!--main content-->
<%= render :partial => "standard_form" %>
<!--/content-->
<% end %>
