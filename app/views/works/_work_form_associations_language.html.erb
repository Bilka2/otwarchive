<% # expects local variable f %>
<dt class="language required">
  <%= f.label :language_id, "#{t('works.form.associations.language.label')} *" %>
  <%= link_to_help_modal(help_works_languages_path, t("works.form.associations.language.help_title")) %>
</dt>
<dd class="language required">
  <select id="work_language_id" name="work[language_id]">
    <option value=""><%= t("works.form.associations.language.required_to_select") %></option>
    <%= options_for_select(language_options_for_select(sorted_languages, "id"), @work.language_id) %>
  </select>
</dd>
